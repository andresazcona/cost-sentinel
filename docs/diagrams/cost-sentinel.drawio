<mxfile host="gen_drawio.py"><diagram id="Architecture" name="Architecture"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Architecture-1" value='&lt;b style="font-size:20px;"&gt;cost-sentinel: weekly AWS waste report&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;EventBridge Scheduler · Lambda (Python 3.12) · EC2 / EBS / ELB / Tagging APIs · SES · Slack · SSM Parameter Store · CloudWatch · SQS&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="Architecture-2" value='&lt;b&gt;SSM Parameter Store&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;Slack webhook (SecureString)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0 · standard tier&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-3" value='&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;cron(0 8 ? * MON *)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0 · 14M free/month&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF7ED;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="300" height="380" as="geometry"/></mxCell><mxCell id="Architecture-5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="64" height="64" as="geometry"/></mxCell><mxCell id="Architecture-6" value='&lt;b&gt;cost-sentinel Lambda&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;Python 3.12 · arm64 · 256 MB&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;~$0 · free tier&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="192" width="200" height="70" as="geometry"/></mxCell><mxCell id="Architecture-7" value='&lt;b&gt;Per region, read-only&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:monospace;font-size:11px;"&gt;unattached_volume&lt;br&gt;unassociated_eip&lt;br&gt;old_snapshot&lt;br&gt;stopped_instance&lt;br&gt;old_ami (opt-in)&lt;br&gt;idle_load_balancer&lt;br&gt;missing_tags&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Then&lt;/b&gt;&lt;br&gt;1. drop cost-sentinel:ignore=true&lt;br&gt;2. remediate (opt-in, dry-run default)&lt;br&gt;3. totals by check / region, top N&lt;br&gt;4. email + Slack, full list to logs' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="275" width="280" height="270" as="geometry"/></mxCell><mxCell id="Architecture-8" value="AWS account: every region in REGIONS" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="980" height="530" as="geometry"/></mxCell><mxCell id="Architecture-9" value="us-east-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="160" width="920" height="200" as="geometry"/></mxCell><mxCell id="Architecture-10" value='&lt;b&gt;Amazon EBS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;volumes · snapshots&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_block_store;" vertex="1" parent="1"><mxGeometry x="980" y="210" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-11" value='&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;instances · EIPs · AMIs&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="1200" y="210" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-12" value='&lt;b&gt;Elastic Load Balancing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;ALB / NLB · target health&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="1420" y="210" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-13" value='&lt;b&gt;Resource Groups Tagging API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;GetResources&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.resource_explorer;" vertex="1" parent="1"><mxGeometry x="1640" y="210" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-14" value="eu-west-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="400" width="920" height="200" as="geometry"/></mxCell><mxCell id="Architecture-15" value='&lt;b&gt;Amazon EBS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;volumes · snapshots&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_block_store;" vertex="1" parent="1"><mxGeometry x="980" y="450" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-16" value='&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;instances · EIPs · AMIs&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="1200" y="450" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-17" value='&lt;b&gt;Elastic Load Balancing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;ALB / NLB · target health&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="1420" y="450" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-18" value='&lt;b&gt;Resource Groups Tagging API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;GetResources&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.resource_explorer;" vertex="1" parent="1"><mxGeometry x="1640" y="450" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-19" value="weekly · async invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-3" target="Architecture-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-20" value="GetParameter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0;exitY=0.05;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-21" value="Describe* (read-only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.34210526315789475;exitDx=0;exitDy=0;entryX=0;entryY=0.3584905660377358;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-22" value="Delete* (opt-in)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.868421052631579;exitDx=0;exitDy=0;entryX=0;entryY=0.7358490566037735;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-23" value='&lt;b&gt;SQS dead-letter queue&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;failed runs + deliveries&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0 · 1M free/month&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-24" value='&lt;b&gt;CloudWatch alarm&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;DLQ depth &amp;gt; 0&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0 · 10 free alarms&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="320" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-25" value='&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;one JSON line per finding · 30 d&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0 · 5 GB free&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="500" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-26" value='&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;SendEmail: HTML + text&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;~$0.0004 / month&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="Architecture-27" value='&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;POST to incoming webhook&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4A154B;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="980" y="770" width="170" height="60" as="geometry"/></mxCell><mxCell id="Architecture-28" value="failed delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-3" target="Architecture-23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="379"/><mxPoint x="60" y="799"/></Array></mxGeometry></mxCell><mxCell id="Architecture-29" value="failed run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.9210526315789473;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139" y="520"/></Array></mxGeometry></mxCell><mxCell id="Architecture-30" value="depth &amp;gt; 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-23" target="Architecture-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-31" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.4633333333333333;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Architecture-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.8666666666666667;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="690"/><mxPoint x="799" y="690"/></Array></mxGeometry></mxCell><mxCell id="Architecture-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.9666666666666667;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Architecture-4" target="Architecture-27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="660"/><mxPoint x="1065" y="660"/></Array></mxGeometry></mxCell><mxCell id="Architecture-34" value="&lt;b&gt;Safety model&lt;/b&gt;&lt;br&gt;• Read role: Describe* + tag:GetResources only, scoped with aws:RequestedRegion&lt;br&gt;• Remediation policy is separate, attached only when enable_remediation=true&lt;br&gt;• Explicit IAM Deny on resources tagged cost-sentinel:ignore=true (also in code)&lt;br&gt;• DRY_RUN=true by default; only the literal 'false' turns it off&lt;br&gt;• Volumes are snapshotted, and the snapshot completed, before delete&lt;br&gt;• Slack webhook lives in SSM, never in Terraform state or env vars" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1220" y="700" width="640" height="150" as="geometry"/></mxCell><mxCell id="Architecture-35" value='&lt;b&gt;Running cost ≈ $0.00 / month&lt;/b&gt; (us-east-1, 1 weekly run, ~60 s)&lt;br&gt;&lt;span style="font-size:11px;"&gt;Lambda 4 runs × 60 s × 0.25 GB = 60 GB-s (free: 400,000) · Scheduler 4 invocations (free: 14M) · SES 4 emails × $0.0001 · Logs &amp;lt; 10 MB (free: 5 GB) · SQS + 1 alarm within free tier · Describe API calls are free&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1820" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Decision flow" name="Decision flow"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Decision flow-1" value='&lt;b style="font-size:20px;"&gt;What happens to one finding&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;detect · estimate · allowlist · remediation gate · dry-run · snapshot-before-delete · report&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="Decision flow-2" value='&lt;b&gt;Detect&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;check(region, cfg)&lt;br&gt;Describe* only&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-3" value='&lt;b&gt;Estimate $/month&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;static us-east-1 price table&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-4" value="Tagged&lt;br&gt;cost-sentinel:&lt;br&gt;ignore=true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="170" height="110" as="geometry"/></mxCell><mxCell id="Decision flow-5" value="Check listed&lt;br&gt;in REMEDIATE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="170" height="110" as="geometry"/></mxCell><mxCell id="Decision flow-6" value="DRY_RUN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="170" height="110" as="geometry"/></mxCell><mxCell id="Decision flow-7" value="EBS volume?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="170" height="110" as="geometry"/></mxCell><mxCell id="Decision flow-8" value='&lt;b&gt;Snapshot volume&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;tag source-volume,&lt;br&gt;wait until completed&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#7AA116;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-9" value='&lt;b&gt;Delete volume&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;only after backup&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#C62828;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="130" width="160" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-10" value='&lt;b&gt;Skip&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;counted as allowlisted,&lt;br&gt;never touched&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#888888;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-11" value='&lt;b&gt;Report only&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;stopped instances, idle LBs,&lt;br&gt;tags are always here&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#888888;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-12" value='&lt;b&gt;Log only&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;outcome: would ...&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#888888;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-13" value='&lt;b&gt;Act&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;release EIP · delete snapshot&lt;br&gt;· deregister AMI&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#C62828;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-14" value='&lt;b&gt;On API error&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;outcome: failed: ...&lt;br&gt;run continues, shown in report&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEA;strokeColor=#C62828;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="330" width="200" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-15" value='&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;total $/month · by check · by region · top N offenders · remediation outcomes · checks that failed · allowlisted count&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1A73E8;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1820" height="90" as="geometry"/></mxCell><mxCell id="Decision flow-16" value='&lt;b&gt;Notify&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;SES email + Slack webhook&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="800" y="650" width="78" height="78" as="geometry"/></mxCell><mxCell id="Decision flow-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-2" target="Decision flow-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-3" target="Decision flow-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-4" target="Decision flow-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-5" target="Decision flow-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-21" value="no (live)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-6" target="Decision flow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-7" target="Decision flow-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-8" target="Decision flow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-4" target="Decision flow-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-5" target="Decision flow-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-26" value="yes (default)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-6" target="Decision flow-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="Decision flow-7" target="Decision flow-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-28" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-9" target="Decision flow-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="275"/><mxPoint x="1580" y="275"/></Array></mxGeometry></mxCell><mxCell id="Decision flow-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.31043956043956045;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-10" target="Decision flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4423076923076923;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-11" target="Decision flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5741758241758241;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-12" target="Decision flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7060439560439561;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-13" target="Decision flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8461538461538461;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-14" target="Decision flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-9" target="Decision flow-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="175"/><mxPoint x="1890" y="565"/></Array></mxGeometry></mxCell><mxCell id="Decision flow-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.439010989010989;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Decision flow-15" target="Decision flow-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Decision flow-36" value="&lt;b&gt;Why this order&lt;/b&gt;&lt;br&gt;• The allowlist is checked before anything else, and IAM denies the same tag again.&lt;br&gt;• Remediation needs three independent switches: the IAM policy (enable_remediation),&lt;br&gt;&amp;nbsp;&amp;nbsp;the check in REMEDIATE, and DRY_RUN=false.&lt;br&gt;• Deleting a volume waits for its snapshot; the snapshot ages out via old_snapshot.&lt;br&gt;• One failed resource or check never hides the rest of the report." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="900" height="150" as="geometry"/></mxCell><mxCell id="Decision flow-37" value="&lt;b&gt;Estimates (approximate, us-east-1)&lt;/b&gt;&lt;br&gt;EBS gp3 $0.08 / gp2 $0.10 / io1-io2 $0.125 per GB-month · snapshot $0.05 per GB-month (upper bound, incremental) · idle EIP $0.005/h = $3.65 · ALB/NLB $0.0225/h = $16.43 · missing tags $0 (governance, not waste)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="980" y="800" width="880" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
